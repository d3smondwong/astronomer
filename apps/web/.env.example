# apps/web environment variables — template.
# Copy to .env.local and fill in real values:  cp .env.example .env.local
# (.env.local is gitignored; this example is committed as the documented contract.)
#
# Next.js loads, in precedence order: .env.local > .env.[development|production] > .env
# NEXT_PUBLIC_* values are bundled into the BROWSER — never put real secrets in them.

# ── Google Maps ───────────────────────────────────────────────────────────────
# Shipped to the browser (the Maps JS API runs client-side), so it can't be secret.
# SECURITY: protect it by RESTRICTING the key in GCP Console, not by hiding it:
#   1. Application restriction → HTTP referrers: localhost + your prod domain only
#   2. API restriction → Maps JavaScript API + Places API only
#   3. Usage quota + billing alert to cap abuse
# Apply this to EVERY environment's key before deploy.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-restricted-maps-key

# ── Firebase (Admin SDK, server-side) ───────────────────────────────────────────
# For local dev these point the Admin SDK at the emulators. UNSET in production so it
# connects to real Firebase (via Application Default Credentials / service account).
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
GOOGLE_CLOUD_PROJECT=demo-astronomer
FIREBASE_PROJECT_ID=demo-astronomer

# ── Firebase (client SDK, browser) ──────────────────────────────────────────────
# Firebase web "API keys" are project identifiers, not secrets (secured by Firestore/Auth
# rules + App Check). In production use the real project's values.
NEXT_PUBLIC_USE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-astronomer
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key

# ── Insights cache ──────────────────────────────────────────────────────────────
# Set to false to disable the LLM-insights cache (every request regenerates fresh) —
# useful while iterating on prompts. Omit or =true to cache (default). Server-side only.
INSIGHTS_CACHE_ENABLED=true

# ── FastAPI backend ─────────────────────────────────────────────────────────────
# Base URL of the FastAPI service the route handlers call. Defaults to localhost:8000.
# FASTAPI_URL=http://localhost:8000
# FASTAPI_BEARER_TOKEN=
