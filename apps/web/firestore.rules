rules_version = '2';

// All Firestore access goes through the Admin SDK (server-side), which bypasses
// these rules. Client SDK access is denied by default. When client-side reads or
// Auth are introduced (Phase 2), open up specific paths here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
